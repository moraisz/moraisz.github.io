---
import profile from '../assets/profile.webp';
---

<section id="inicio" class="container hero">
	<div class="profile-frame">
		<img src={profile.src} alt="Marcos Vinícius Morais" width="320" height="320" />
	</div>
	<div>
		<h1 class="hero-title">Engenheiro de Software<br /><span class="muted">Full Stack</span></h1>
		<p class="hero-copy">Desenvolvedor apaixonado por criar soluções escaláveis e eficientes, com expertise em desenvolvimento web moderno e arquitetura de sistemas.</p>
		<div class="social-links" aria-label="Redes sociais">
			<a class="icon-button" href="https://github.com/moraisz" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="ph-fill ph-github-logo" aria-hidden="true"></i></a>
			<a class="icon-button" href="https://linkedin.com/in/moraisz" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="ph-fill ph-linkedin-logo" aria-hidden="true"></i></a>
			<a class="icon-button" href="mailto:marcosviniciusm99@gmail.com" aria-label="Enviar e-mail"><i class="ph ph-envelope" aria-hidden="true"></i></a>
		</div>
		<a class="primary-button" href="#contato">Entre em contato</a>
	</div>
</section>
